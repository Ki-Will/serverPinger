{
  "name": "ping-server",
  "version": "1.0.0",
  "description": "A monitoring service to ping specified endpoints at regular intervals",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "echo 'No build step required for Node.js server'",
    "test": "jest --coverage",
    "lint": "eslint . --ext .js",
    "format": "prettier --write .",
    "prepare": "husky install",
    "docker:build": "docker build -t ping-server .",
    "docker:run": "docker run -p 3000:3000 -d --name ping-server ping-server",
    "docker:stop": "docker stop ping-server && docker rm ping-server",
    "docker:logs": "docker logs -f ping-server",
    "clean": "rm -rf node_modules package-lock.json",
    "preinstall": "npx only-allow pnpm"
  },
  "keywords": [
    "monitoring",
    "ping",
    "uptime",
    "health-check"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-node": "^11.1.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "nodemon": "^3.0.3",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/ping-server.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/ping-server/issues"
  },
  "homepage": "https://github.com/yourusername/ping-server#readme",
  "lint-staged": {
    "*.{js}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}